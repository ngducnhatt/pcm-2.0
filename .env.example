# ============================================================
# PCM OpsFlow - sao chép file này thành .env.local rồi sửa.
# TUYỆT ĐỐI không commit .env.local / mật khẩu thật.
# ============================================================

# MySQL của XAMPP. Mật khẩu có ký tự đặc biệt phải URL-encode.
# Ví dụ: p@ss#1 -> p%40ss%231
DATABASE_URL=mysql://pcm_app:CHANGE_ME@127.0.0.1:3306/pcm_opsflow

# (Tùy chọn) Tài khoản có quyền DDL riêng cho migration.
# Nếu bỏ trống, db:migrate dùng DATABASE_URL.
# MIGRATE_DATABASE_URL=mysql://pcm_migrate:CHANGE_ME@127.0.0.1:3306/pcm_opsflow

# (Tùy chọn) Tài khoản chỉ đọc cho mysqldump.
# Nếu bỏ trống, db:backup dùng DATABASE_URL.
# BACKUP_DATABASE_URL=mysql://pcm_backup:CHANGE_ME@127.0.0.1:3306/pcm_opsflow

# Số connection tối đa trong pool.
PG_POOL_MAX=10

# Thông tin tạo admin ĐẦU TIÊN bằng `npm run db:admin`.
# Để trống ADMIN_PASSWORD để CLI hỏi mật khẩu kín (khuyến nghị).
# Mật khẩu phải >= 12 ký tự và có ít nhất 3 nhóm ký tự.
ADMIN_NAME=Quản trị viên PCM
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345678

# Domain công khai, dùng cho tài liệu và kiểm tra Origin.
APP_PUBLIC_URL=https://opsflow.example.com

# Chỉ bật khi app CHỈ nhận request từ reverse proxy trên cùng máy
# (cloudflared / Caddy). Xem README phần bảo mật proxy.
TRUST_PROXY=true

# cloudflare: ưu tiên CF-Connecting-IP (cloudflared phải ghi đè header này)
# caddy:       ưu tiên X-Real-IP và bỏ qua CF-Connecting-IP
# auto:        cloudflare nếu có, sau đó X-Real-IP / X-Forwarded-For
PROXY_MODE=cloudflare

# Bắt buộc true khi chạy HTTPS ở production. Nếu test HTTP trên máy local,
# có thể đặt false trong thời gian ngắn; KHÔNG dùng false khi mở Internet.
COOKIE_SECURE=true

# Thời hạn phiên đăng nhập (giờ).
SESSION_TTL_HOURS=12

# API key Google Maps (tùy chọn, giữ bí mật ở server, không đưa ra frontend).
GOOGLE_MAPS_API_KEY=

# ===== Process runner (npm run serve) =====
# Chỉ đổi nếu cổng 3000 đã bị chiếm. App vẫn chỉ bind 127.0.0.1.
PORT=3000
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_KEEP_DAYS=30

# ===== Công cụ sao lưu (chạy trên máy chủ) =====
# Đường dẫn mysqldump.exe của XAMPP, ví dụ:
# C:\xampp\mysql\bin\mysqldump.exe
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
BACKUP_DIR=backups
BACKUP_KEEP=14
